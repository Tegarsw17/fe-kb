# Copy this file to `.env` if you need to change where the app gets its data.
#
# Default (no .env): the REST API at `/api` on the same domain as the web app.
# In `npm run dev`, Vite forwards /api to https://kebun.43-157-235-41.sslip.io
# (set API_PROXY_TARGET=http://localhost:3000 in your shell to use a local API).
# VITE_API_URL=/api
#
# Set VITE_API_URL= (empty) to use Supabase instead, with the keys below,
# or to run in demo mode (sample data in the browser) when they are empty too.
# VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
